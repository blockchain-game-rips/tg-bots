# Required

# Auth token
BOT_TOKEN=
# The group where the bot will send messages about finished rips
GAME_GROUP_ID=
BACKEND_URL=
# Shared secret for the backend's user routes
USER_API_KEY=

# Optional

# Port for the metrics server
METRICS_PORT=9090

# Port the gate listens on. Kept separate from METRICS_PORT because only this
# one is ever reachable from outside — /metrics must never be published.
GATE_PORT=8787

# Local development only: stands in for the CF-IPCountry header, which exists
# only behind Cloudflare. Ignored unless NODE_ENV is development, so it can
# never spoof the country in production.
GATE_DEV_COUNTRY=
