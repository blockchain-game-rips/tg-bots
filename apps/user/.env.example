# Required

# Auth token
BOT_TOKEN=
# The group where the bot will send messages about finished rips
GAME_GROUP_ID=
BACKEND_URL=
# Shared secret for the backend's user routes
USER_API_KEY=

# Optional

# Port for the metrics server
METRICS_PORT=9090

# Port the gate listens on, bound to 127.0.0.1. Reached only through the
# Cloudflare tunnel, which runs on the same host and forwards to this port.
GATE_PORT=8787

# Public HTTPS address of the gate, no trailing slash. The consent screen's
# Agree button opens this as a mini app, so it must be the address Telegram can
# reach — not the local GATE_PORT.
GATE_URL=

# Local development only: stands in for the CF-IPCountry header, which exists
# only behind Cloudflare. Ignored unless NODE_ENV is development, so it can
# never spoof the country in production.
GATE_DEV_COUNTRY=
