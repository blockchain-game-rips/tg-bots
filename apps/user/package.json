{
	"name": "user",
	"version": "1.0.0",
	"private": true,
	"main": "src/main.ts",
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"dev:preview": "dotenv -e .env.preview -- tsx watch scripts/preview-bot/index.ts",
		"preview-bot": "tsx scripts/preview-bot/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"action-ids": "tsx scripts/action-ids.ts",
		"action-ids:check": "tsx scripts/action-ids.ts --check",
		"start": "node dist/src/main.js",
		"start:preview": "node dist/scripts/preview-bot/index.js",
		"test": "vitest run --project apps/user --passWithNoTests",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@grammyjs/auto-retry": "^2.0.2",
		"@grammyjs/menu": "^1.3.1",
		"@grammyjs/runner": "^2.0.3",
		"@rips/api-client": "*",
		"@rips/grammy-kit": "*",
		"@rips/shared": "*",
		"dotenv": "^17.3.1",
		"grammy": "^1.40.1",
		"pino": "^10.3.1",
		"prom-client": "^15.1.3",
		"qrcode": "^1.5.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/qrcode": "^1.5.6",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0"
	}
}
