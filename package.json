{
	"name": "tg-bots",
	"private": true,
	"workspaces": ["packages/*", "apps/*"],
	"scripts": {
		"dev:rips": "yarn workspace @rips/bot-rips dev",
		"dev:admin": "yarn workspace @rips/bot-admin dev",
		"build": "yarn workspaces foreach -At run build",
		"build:rips": "yarn workspace @rips/bot-rips build",
		"build:admin": "yarn workspace @rips/bot-admin build",
		"test": "yarn workspaces foreach -A run test",
		"fmt": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\"",
		"lint": "yarn workspaces foreach -A run lint"
	},
	"devDependencies": {
		"@eslint/js": "9.26.0",
		"@types/jest": "29.5.14",
		"@types/node": "^25.3.1",
		"eslint": "^9.0.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"jest": "30.0.2",
		"prettier": "^3.8.1",
		"prettier-plugin-organize-imports": "4.1.0",
		"ts-jest": "29.4.0",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.32.0"
	}
}
