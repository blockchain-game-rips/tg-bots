{
	"name": "tg-bots",
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"prepare": "lefthook install",
		"user": "yarn workspace user",
		"admin": "yarn workspace admin",
		"api-client": "yarn workspace @rips/api-client",
		"shared": "yarn workspace @rips/shared",
		"grammy-kit": "yarn workspace @rips/grammy-kit",
		"build": "yarn workspaces foreach -At run build",
		"test": "yarn workspaces foreach -A run test",
		"fmt": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\"",
		"lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\" --fix",
		"typecheck": "yarn workspaces foreach -A run typecheck"
	},
	"devDependencies": {
		"@eslint/js": "9.26.0",
		"@types/node": "^25.3.1",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.0.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"lefthook": "^2.1.9",
		"prettier": "^3.8.1",
		"prettier-plugin-organize-imports": "4.1.0",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.59.4",
		"vitest": "^4.1.10"
	},
	"packageManager": "yarn@4.14.1"
}
