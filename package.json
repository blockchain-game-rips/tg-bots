{
	"name": "tg-bots",
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/*",
		"tools/*"
	],
	"scripts": {
		"prepare": "lefthook install",
		"user": "yarn workspace user",
		"admin": "yarn workspace admin",
		"api-client": "yarn workspace @rips/api-client",
		"shared": "yarn workspace @rips/shared",
		"grammy-kit": "yarn workspace @rips/grammy-kit",
		"build": "yarn workspaces foreach -At run build",
		"test": "yarn workspaces foreach -A run test",
		"fmt": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\"",
		"lint": "tools/eslint-runner/node_modules/.bin/eslint --config tools/eslint-runner/eslint.config.mjs \"apps/**/*.ts\" \"packages/**/*.ts\" --fix",
		"typecheck": "yarn workspaces foreach -A run typecheck"
	},
	"devDependencies": {
		"@types/node": "^25.3.1",
		"dotenv-cli": "^11.0.0",
		"lefthook": "^2.1.9",
		"prettier": "^3.8.1",
		"prettier-plugin-organize-imports": "4.1.0",
		"ts-node-dev": "^2.0.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"packageManager": "yarn@4.17.1"
}
